            <trans-unit id="scheduler.import.argument.username.description" resname="scheduler.import.argument.username.description">
                <source>Optional BasicAuth username. Leave empty to use HIO_TYPO3_CONNECTOR_BASIC_AUTH_USERNAME from the process environment if available; otherwise no BasicAuth is used.</source>
                <target>Optionaler BasicAuth-Username. Leer lassen, um HIO_TYPO3_CONNECTOR_BASIC_AUTH_USERNAME aus der Prozessumgebung zu verwenden, falls verfügbar; andernfalls wird kein BasicAuth verwendet.</target>
